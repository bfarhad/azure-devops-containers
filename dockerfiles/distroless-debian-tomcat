FROM debian AS env_box

ARG TOMCAT_V_VERSION
ARG TOMCAT_VERSION

ENV CATALINA_BASE="/opt/apache-tomcat-10"
ENV JAVA_HOME="/java"

RUN apt-get -q update; \
  apt-get -q install -y curl tar \
  && TMP_DIR=$(mktemp -d) \
  && curl -Ls \
    https://corretto.aws/downloads/latest/amazon-corretto-21-x64-linux-jdk.tar.gz \
    | tar -xz -C $TMP_DIR --strip-components=1 \
  && mv $TMP_DIR /java

RUN apt-get update; \
  apt-get -y install curl tar \
  && TOMCAT_TMP_DIR=$(mktemp -d) \
  && curl -Ls \
    https://archive.apache.org/dist/tomcat/tomcat-10/v10.1.24/bin/apache-tomcat-10.1.24.tar.gz \
    | tar -xz -C $TOMCAT_TMP_DIR --strip-components=1 \
  && cp -r $TOMCAT_TMP_DIR/ $CATALINA_BASE

FROM gcr.io/distroless/base:debug

LABEL "Base"="google distroless on debian 10" \
  "release"="dev" \
  "owner"="Vi"

ENV JAVA_HOME=/java
ENV CATALINA_BASE=/opt/apache-tomcat-10
ENV CATALINA_HOME=$CATALINA_BASE
ENV CLASSPATH=$CATALINA_BASE/bin/bootstrap.jar:$CATALINA_BASE/bin/tomcat-juli.jar
ENV PATH=$PATH:$CATALINA_BASE/bin:/java/bin
ENV LD_LIBRARY_PATH $LD_LIBRARY_PATH:/opt/apache-tomcat-10/native_lib
ENV _JAVA_OPTIONS="\
$CATALINA_OPTS \
$JAVA_OPTS \
-Djava.util.logging.config.file=$CATALINA_BASE/conf/logging.properties \
-Djava.util.logging.manager=org.apache.juli.ClassLoaderLogManager \
-Dcatalina.base=$CATALINA_BASE \
-Dcatalina.home=$CATALINA_HOME \
"

COPY --from=env_box --chown=nonroot $CATALINA_BASE $CATALINA_BASE
COPY --from=env_box $JAVA_HOME $JAVA_HOME

WORKDIR $CATALINA_BASE
USER nonroot
EXPOSE 8080

CMD ["java", "org.apache.catalina.startup.Bootstrap"]
